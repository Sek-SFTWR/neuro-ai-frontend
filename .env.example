# Copy to .env.local for development, and set all three in Vercel for the deploy.
# The app fails closed: if ANY of them is missing, every route redirects to
# /login and /login refuses to authenticate anyone (503).

# The one shared login coworkers type at /login. This is a single credential
# everyone shares, not per-person accounts — it cannot record who signed in.
# The email is compared case-insensitively and trimmed.
APP_EMAIL=
APP_PASSWORD=

# Signs the session cookie. Must be long and random — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing ANY of the three variables invalidates all sessions already issued.
AUTH_SECRET=
