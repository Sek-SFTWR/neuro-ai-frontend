# Copy to .env.local for development, and set both in Vercel for the deploy.
# The app fails closed: if either is missing, every route redirects to /login
# and /login refuses to authenticate anyone.

# The shared password coworkers type at /login.
APP_PASSWORD=

# Signs the session cookie. Must be long and random — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing either variable invalidates all sessions already issued.
AUTH_SECRET=
